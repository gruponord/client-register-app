PORT=3002
DATABASE_URL=postgresql://user:pass@localhost:5432/client_register
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_password
SMTP_FROM=noreply@example.com
CORS_ORIGIN=https://your-domain.com
UPLOAD_DIR=./uploads

# --- Receptor del Sincronizador GNP (CONTRATO-SYNC.md) ---
# Clave que presenta el agente en X-Api-Key. Sin ella el receptor responde 503
# en vez de quedarse abierto. Debe coincidir con APP_ALTAS_APIKEY del agente.
SYNC_API_KEY=
# Conexion con la que se escribe el esquema `erp`. Opcional: si se deja vacia se
# usa DATABASE_URL. Ver src/db/permisos-sync.sql.
SYNC_DATABASE_URL=
